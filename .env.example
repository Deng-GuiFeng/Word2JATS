# 模型密钥配置。复制为 .env 并填入真实 Key。
# 本项目的转换方法由大模型承担结构理解，必须配置至少一个后端的 Key；
# 全新转换需要有效凭据；缺 Key 且缓存不完整时无法完成结构理解。
# 默认后端为阿里云百炼 DashScope（qwen3.7-plus）。

# 阿里云百炼 DashScope（OpenAI 兼容模式，默认后端）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek（OpenAI 兼容，可选替代后端）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
